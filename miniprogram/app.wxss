page {
  min-height: 100%;
  background: #f4f2eb;
  color: #222222;
  font-family: "Microsoft YaHei", "微软雅黑", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

view,
text,
input,
textarea,
button,
picker {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 30rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f4f2eb;
}

.safe-page {
  min-height: 100vh;
  padding: 30rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f4f2eb;
}

.content-section {
  margin-top: 28rpx;
}

.panel {
  background: rgba(255, 255, 255, 0.34);
  border: 1rpx solid #dfddd6;
  border-radius: 18rpx;
}

.state-card {
  min-height: 188rpx;
  padding: 34rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #666666;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-btn {
  height: 84rpx;
  border-radius: 14rpx;
  background: #222222;
  color: #f4f2eb;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.ghost-btn {
  height: 80rpx;
  border: 1rpx solid #d5d3cc;
  border-radius: 14rpx;
  background: transparent;
  color: #222222;
  font-size: 28rpx;
  line-height: 80rpx;
}

.brand-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.brand-title {
  color: #222222;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: #666666;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.round-action {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #dfddd6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
  font-size: 30rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.28);
}

.section-title {
  margin: 34rpx 0 8rpx;
  color: #222222;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.muted {
  color: #666666;
}

.tag {
  display: inline-flex;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  padding: 7rpx 13rpx;
  border: 1rpx solid #dedbd2;
  border-radius: 999rpx;
  color: #222222;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
}

.tag-alert {
  color: #671463;
  border-color: #671463;
}

.disclaimer-box {
  margin: 22rpx 0;
  padding: 20rpx 22rpx;
  border: 1rpx dashed rgba(103, 20, 99, 0.72);
  border-radius: 16rpx;
  background: rgba(103, 20, 99, 0.055);
  color: #671463;
  font-size: 23rpx;
  line-height: 1.6;
}

.disclaimer-title {
  display: block;
  margin-bottom: 8rpx;
  font-weight: 900;
}
