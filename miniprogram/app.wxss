page {
  min-height: 100%;
  background: #f7f4ef;
  color: #20231f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

view,
text,
input,
textarea,
button,
picker {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 44rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e7ded3;
  border-radius: 16rpx;
}

.primary-btn {
  height: 88rpx;
  border-radius: 16rpx;
  background: #25735a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.ghost-btn {
  height: 80rpx;
  border: 1rpx solid #cdded6;
  border-radius: 16rpx;
  background: #f4fbf7;
  color: #25735a;
  font-size: 28rpx;
  line-height: 80rpx;
}
