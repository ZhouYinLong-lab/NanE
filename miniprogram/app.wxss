@font-face {
  font-family: "Font Awesome 6 Free";
  src: url("./assets/fontawesome/fa-solid-900.woff2") format("woff2");
  font-weight: 900;
  font-style: normal;
}

page {
  min-height: 100%;
  background: linear-gradient(160deg, #f7f1e6 0%, #eadfce 56%, #dccbb4 100%);
  color: #2f261d;
  font-family: "Nunito", "Microsoft YaHei", "微软雅黑", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

view,
text,
input,
textarea,
button,
picker,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.fa {
  font-family: "Font Awesome 6 Free", "Microsoft YaHei", sans-serif;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(58rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #f7f1e6 0%, #eadfce 56%, #dccbb4 100%);
}

.panel,
.soft-card {
  background: #fffaf2;
  border: 1rpx solid #e1d2bd;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(96, 68, 36, 0.08);
}

.state-card {
  min-height: 188rpx;
  padding: 34rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a7661;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.55;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.screen-title {
  flex: 1;
  text-align: center;
  color: #2f261d;
  font-size: 30rpx;
  font-weight: 900;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  color: #fffaf2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 8rpx 18rpx rgba(75, 18, 63, 0.16);
}

.avatar-dot {
  width: 16rpx;
  height: 16rpx;
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  border: 3rpx solid #f7f1e6;
  border-radius: 50%;
  background: #4b123f;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fffaf2;
  border: 1rpx solid #e1d2bd;
  color: #4b123f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(96, 68, 36, 0.07);
}

.section-head {
  margin: 26rpx 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #2f261d;
  font-size: 28rpx;
  font-weight: 900;
}

.section-more,
.muted {
  color: #8a7661;
  font-size: 22rpx;
}

.tag,
.badge {
  display: inline-flex;
  align-items: center;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f3eadf;
  color: #4b123f;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
}

.tag-alert,
.badge-main {
  background: rgba(75, 18, 63, 0.1);
  color: #4b123f;
}

.primary-btn {
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  color: #fffaf2;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 82rpx;
  box-shadow: 0 10rpx 24rpx rgba(75, 18, 63, 0.22);
}

.field-control {
  width: 100%;
  min-height: 72rpx;
  border-radius: 20rpx;
  background: #fffaf2;
  border: 1rpx solid #e1d2bd;
  color: #2f261d;
  font-size: 26rpx;
}

.field-control,
.picker {
  height: 72rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
}

.textarea-control {
  height: auto;
  min-height: 148rpx;
  padding: 18rpx 20rpx;
  line-height: 1.5;
}
