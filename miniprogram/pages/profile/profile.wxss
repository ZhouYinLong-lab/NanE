.profile-page {
  overflow-x: hidden;
}

.profile-hero {
  margin-bottom: 18rpx;
  padding: 30rpx 24rpx;
  border-radius: 30rpx;
  background: #6E0065;
  color: #fffaf2;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(110, 0, 101, 0.18);
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.2);
  border: 3rpx solid rgba(255, 250, 242, 0.54);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.profile-logo {
  width: 68rpx;
  height: 68rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.profile-campus {
  margin-top: 6rpx;
  color: rgba(255, 250, 242, 0.78);
  font-size: 22rpx;
  font-weight: 700;
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 242, 0.18);
  color: #fffaf2;
  font-size: 20rpx;
  font-weight: 900;
}

.auth-card {
  margin-bottom: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e4ded3;
  background: #fffaf2;
  box-shadow: 0 8rpx 22rpx rgba(96, 68, 36, 0.06);
}

.auth-title {
  color: #1f1f1f;
  font-size: 27rpx;
  font-weight: 900;
}

.auth-desc {
  margin-top: 8rpx;
  color: #6f6a61;
  font-size: 22rpx;
  line-height: 1.55;
}

.auth-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.auth-input {
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #e1d2bd;
  border-radius: 18rpx;
  background: #fffdf8;
  color: #1f1f1f;
  font-size: 23rpx;
}

.auth-code-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  align-items: center;
}

.auth-code-input {
  flex: 1;
  min-width: 0;
}

.auth-button {
  width: 118rpx;
  height: 76rpx;
  padding: 0;
  border-radius: 18rpx;
  background: #1f1f1f;
  color: #fffaf2;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.auth-button.primary {
  background: #6E0065;
}

.auth-message {
  margin-top: 12rpx;
  color: #6E0065;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.45;
}

.menu-item {
  min-height: 88rpx;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e4ded3;
  background: #fffaf2;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 22rpx rgba(96, 68, 36, 0.06);
}

.menu-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: rgba(110, 0, 101, 0.09);
  color: #6E0065;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  min-width: 0;
  color: #1f1f1f;
  font-size: 25rpx;
  font-weight: 900;
}

.menu-badge {
  max-width: 220rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #f3eadf;
  color: #6f6a61;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.menu-arrow {
  color: #b59e84;
  font-size: 20rpx;
}

.switch-btn {
  margin-top: 24rpx;
}

@media (max-width: 360px) {
  .auth-grid {
    grid-template-columns: 1fr;
  }
}
