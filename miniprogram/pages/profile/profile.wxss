.profile-header {
  display: flex;
  align-items: center;
  gap: 34rpx;
  margin-bottom: 42rpx;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #c4c5bd;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 900;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.name {
  color: #222222;
  font-size: 38rpx;
  font-weight: 900;
}

.campus {
  margin-top: 8rpx;
  color: #666666;
  font-size: 25rpx;
}

.auth-badge {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid #671463;
  border-radius: 999rpx;
  background: rgba(103, 20, 99, 0.08);
  color: #671463;
  font-size: 22rpx;
  font-weight: 900;
}

.menu-row {
  min-height: 98rpx;
  border-bottom: 1rpx solid #e0ddd3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #222222;
  font-size: 29rpx;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-row text:last-child {
  color: #666666;
  text-align: right;
  font-size: 24rpx;
}

.switch-btn {
  margin-top: 42rpx;
  background: #c4c5bd;
  color: #222222;
}
