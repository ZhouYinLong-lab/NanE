.profile-page {
  overflow-x: hidden;
}

.profile-hero {
  margin-bottom: 18rpx;
  padding: 30rpx 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  color: #fffaf2;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(75, 18, 63, 0.18);
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.2);
  border: 3rpx solid rgba(255, 250, 242, 0.54);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.profile-campus {
  margin-top: 6rpx;
  color: rgba(255, 250, 242, 0.78);
  font-size: 22rpx;
  font-weight: 700;
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 242, 0.18);
  color: #fffaf2;
  font-size: 20rpx;
  font-weight: 900;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  padding: 18rpx 8rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e1d2bd;
  background: #fffaf2;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(96, 68, 36, 0.06);
}

.stat-num {
  color: #4b123f;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.stat-label {
  margin-top: 5rpx;
  color: #8a7661;
  font-size: 19rpx;
  font-weight: 800;
}

.menu-item {
  min-height: 88rpx;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e1d2bd;
  background: #fffaf2;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 22rpx rgba(96, 68, 36, 0.06);
}

.menu-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: rgba(75, 18, 63, 0.09);
  color: #4b123f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  min-width: 0;
  color: #2f261d;
  font-size: 25rpx;
  font-weight: 900;
}

.menu-badge {
  max-width: 220rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #f3eadf;
  color: #6f5a45;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.menu-arrow {
  color: #b59e84;
  font-size: 20rpx;
}

.switch-btn {
  margin-top: 24rpx;
}
