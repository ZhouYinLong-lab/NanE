.profile-card {
  padding: 34rpx;
  border-radius: 20rpx;
  background: #183f32;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #f5d275;
  color: #183f32;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
}

.campus {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
}

.stats {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat {
  padding: 24rpx 10rpx;
  text-align: center;
}

.num {
  color: #25735a;
  font-size: 32rpx;
  font-weight: 800;
}

.text {
  margin-top: 8rpx;
  color: #7b877f;
  font-size: 22rpx;
}

.menu {
  margin-top: 22rpx;
  padding: 8rpx 24rpx;
}

.menu-row {
  min-height: 92rpx;
  border-bottom: 1rpx solid #eee6dc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #20231f;
  font-size: 27rpx;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-row text:last-child {
  color: #7b877f;
  text-align: right;
  font-size: 24rpx;
}

.menu-row .ok {
  color: #25735a;
}
