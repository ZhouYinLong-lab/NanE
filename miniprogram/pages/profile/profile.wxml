<view class="page">
  <view class="brand-header">
    <view>
      <view class="brand-title">我的空间</view>
      <view class="brand-subtitle">User Profile</view>
    </view>
  </view>

  <view class="profile-header">
    <view class="avatar">南</view>
    <view class="profile-info">
      <view class="name">{{user.name || 'Demo 用户'}}</view>
      <view class="campus">{{user.campus || '仙林校区'}} · {{user.building || '南苑 A 栋'}}</view>
      <view class="auth-badge">✓ 校园身份认证 Demo</view>
    </view>
  </view>

  <view class="profile-menu">
    <view class="menu-row" bindtap="openMyItems">
      <text>我发布的互助</text>
      <text>查看审核和上架状态</text>
    </view>
    <view class="menu-row">
      <text>联系方式</text>
      <text>{{user.wechat || 'nane_demo'}}</text>
    </view>
    <view class="menu-row">
      <text>查看历史</text>
      <text>今日余 {{contactLimit.remaining}} 次</text>
    </view>
    <view class="menu-row">
      <text>API 状态</text>
      <text>{{apiStatus}}</text>
    </view>
    <view class="menu-row">
      <text>隐私策略</text>
      <text>查看后展示，每日限 {{contactLimit.daily}} 次</text>
    </view>
  </view>

  <button class="primary-btn switch-btn">退出登录 / 切换账号</button>
</view>
