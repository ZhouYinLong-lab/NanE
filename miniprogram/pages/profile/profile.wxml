<view class="page profile-page">
  <view class="profile-hero">
    <view class="profile-avatar"><image class="profile-logo" src="/assets/brand/nane-logo.png" mode="aspectFit" /></view>
    <view class="profile-info">
      <view class="profile-name">{{user.name || 'Demo 用户'}}</view>
      <view class="profile-campus">{{user.campus || '仙林校区'}} · {{user.building || '南苑 A 栋'}}</view>
      <view class="auth-badge"><text class="fa">{{icons.check}}</text> {{user.is_verified ? '南哪小帮手校园身份已认证' : '校园身份认证 Demo'}}</view>
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-num">{{contactLimit.daily}}</view>
      <view class="stat-label">每日额度</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{contactLimit.remaining}}</view>
      <view class="stat-label">今日剩余</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{apiStatus}}</view>
      <view class="stat-label">API 状态</view>
    </view>
  </view>

  <view class="auth-card">
    <view class="auth-title">南哪小帮手身份验证</view>
    <view class="auth-desc">输入邮箱或学号后，南哪小帮手会发送验证码；验证成功后 NanE 会使用真实校园身份登录。</view>
    <view class="auth-grid">
      <input class="auth-input" value="{{authForm.email}}" data-field="email" bindinput="onAuthInput" placeholder="邮箱（可选）" />
      <input class="auth-input" value="{{authForm.studentId}}" data-field="studentId" bindinput="onAuthInput" placeholder="学号（可选）" />
    </view>
    <view class="auth-code-row">
      <input class="auth-input auth-code-input" value="{{authForm.code}}" data-field="code" bindinput="onAuthInput" placeholder="南哪小帮手验证码" />
      <button class="auth-button" loading="{{authLoading}}" bindtap="sendNannaCode">发送</button>
      <button class="auth-button primary" loading="{{authLoading}}" bindtap="verifyNannaCode">验证</button>
    </view>
    <view wx:if="{{authMessage}}" class="auth-message">{{authMessage}}</view>
  </view>

  <view class="section-head">
    <view class="section-title">我的功能</view>
  </view>

  <view class="profile-menu">
    <view class="menu-item" bindtap="openMyItems">
      <view class="menu-icon"><text class="fa">{{icons.clipboardList}}</text></view>
      <view class="menu-text">我发布的互助</view>
      <view class="menu-badge">审核状态</view>
      <text class="fa menu-arrow">{{icons.chevronRight}}</text>
    </view>
    <view class="menu-item">
      <view class="menu-icon"><text class="fa">{{icons.idCard}}</text></view>
      <view class="menu-text">联系方式</view>
      <view class="menu-badge">{{user.wechat || user.qq || '待设置'}}</view>
    </view>
    <view class="menu-item">
      <view class="menu-icon"><text class="fa">{{icons.clock}}</text></view>
      <view class="menu-text">查看历史</view>
      <view class="menu-badge">今日余 {{contactLimit.remaining}} 次</view>
    </view>
    <view class="menu-item">
      <view class="menu-icon"><text class="fa">{{icons.shieldHeart}}</text></view>
      <view class="menu-text">隐私策略</view>
      <view class="menu-badge">每日限 {{contactLimit.daily}} 次</view>
    </view>
  </view>

  <button class="primary-btn switch-btn" bindtap="switchAccount">退出登录 / 切换账号</button>
</view>
