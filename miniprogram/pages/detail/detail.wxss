.detail-page {
  overflow-x: hidden;
}

.detail-hero {
  padding: 26rpx 22rpx 24rpx;
  text-align: center;
  margin-bottom: 18rpx;
}

.detail-img {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 20rpx;
  border-radius: 34rpx;
  background: #f0e6ef;
  color: #6E0065;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 66rpx;
}

.detail-title {
  margin-bottom: 14rpx;
  color: #1f1f1f;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
  word-break: break-word;
}

.badge-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.detail-card {
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.detail-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e4ded3;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  width: 132rpx;
  color: #6f6a61;
  font-size: 23rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.detail-label .fa {
  width: 28rpx;
  color: #6E0065;
}

.detail-val {
  flex: 1;
  min-width: 0;
  color: #1f1f1f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.55;
  word-break: break-word;
}

.info-callout {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e4ded3;
  background: #fffaf2;
  color: #6f6a61;
  display: flex;
  gap: 12rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.info-callout .fa {
  margin-top: 4rpx;
  color: #6E0065;
  flex-shrink: 0;
}

.contact-card {
  padding: 24rpx;
  text-align: center;
}

.contact-hint {
  margin-bottom: 18rpx;
  color: #6f6a61;
  font-size: 23rpx;
}

.contact-btn {
  height: 74rpx;
  margin: 0;
  border-radius: 24rpx;
  background: #6E0065;
  color: #fffaf2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 74rpx;
  box-shadow: 0 10rpx 24rpx rgba(110, 0, 101, 0.18);
}

.contact-title {
  margin-bottom: 14rpx;
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 900;
}

.contact-row {
  margin-top: 10rpx;
  color: #6E0065;
  font-size: 29rpx;
  font-weight: 900;
  word-break: break-word;
}

.remaining {
  margin-top: 16rpx;
  color: #6f6a61;
  font-size: 22rpx;
}

.limit-note {
  margin: 10rpx auto 0;
  max-width: 520rpx;
  color: #8a7661;
  font-size: 21rpx;
  line-height: 1.5;
}
