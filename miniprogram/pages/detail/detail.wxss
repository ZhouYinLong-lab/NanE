.detail-page {
  overflow-x: hidden;
}

.brand-block {
  text-align: right;
  min-width: 0;
}

.detail-hero {
  padding: 12rpx 0 26rpx;
  text-align: center;
}

.detail-icon {
  width: 148rpx;
  height: 148rpx;
  margin: 0 auto 22rpx;
  border-radius: 30rpx;
  background: #f3edf3;
  color: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 900;
}

.detail-title {
  margin-bottom: 14rpx;
  color: #222222;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.28;
  word-break: break-word;
}

.detail-meta {
  margin-bottom: 16rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.45;
}

.detail-meta text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
}

.tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.detail-desc {
  padding: 26rpx 0;
  border-top: 1rpx solid #e0ddd3;
  border-bottom: 1rpx solid #e0ddd3;
  color: #222222;
  font-size: 26rpx;
  line-height: 1.8;
  word-break: break-word;
}

.contact-card {
  margin-top: 26rpx;
  padding: 28rpx;
  border: 1rpx solid #dedbd2;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.34);
  text-align: center;
}

.contact-hint {
  margin-bottom: 20rpx;
  color: #666666;
  font-size: 24rpx;
  line-height: 1.5;
}

.reveal-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #dbcada;
  color: #222222;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 68rpx;
}

.contact-title {
  margin-bottom: 14rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: 900;
}

.contact-row {
  margin-top: 12rpx;
  font-size: 29rpx;
  font-weight: 900;
  color: #671463;
  word-break: break-word;
}

.remaining {
  margin-top: 18rpx;
  color: #666666;
  font-size: 24rpx;
}
