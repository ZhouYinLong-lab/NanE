.empty {
  padding: 40rpx;
  color: #666666;
  text-align: center;
}

.brand-block {
  text-align: right;
}

.detail-hero {
  padding: 20rpx 0 30rpx;
  text-align: center;
}

.detail-icon {
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 26rpx;
  border-radius: 36rpx;
  background: #f3edf3;
  color: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 76rpx;
  font-weight: 900;
}

.detail-title {
  margin-bottom: 16rpx;
  color: #222222;
  font-size: 44rpx;
  font-weight: 900;
}

.detail-meta {
  margin-bottom: 18rpx;
  display: flex;
  justify-content: center;
  gap: 24rpx;
  flex-wrap: wrap;
  color: #666666;
  font-size: 24rpx;
}

.tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.detail-desc {
  padding: 34rpx 0;
  border-top: 1rpx solid #e0ddd3;
  border-bottom: 1rpx solid #e0ddd3;
  color: #222222;
  font-size: 27rpx;
  line-height: 1.8;
}

.contact-card {
  margin-top: 28rpx;
  padding: 34rpx;
  border: 1rpx solid #d5d3cc;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.42);
  text-align: center;
}

.contact-hint {
  margin-bottom: 22rpx;
  color: #666666;
  font-size: 25rpx;
}

.reveal-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #dbcada;
  color: #222222;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.contact-title {
  margin-bottom: 14rpx;
  color: #222222;
  font-size: 32rpx;
  font-weight: 900;
}

.contact-row {
  margin-top: 12rpx;
  font-size: 31rpx;
  font-weight: 900;
  color: #671463;
}

.remaining {
  margin-top: 18rpx;
  color: #666666;
  font-size: 24rpx;
}
