.empty {
  padding: 40rpx;
  color: #7b877f;
  text-align: center;
}

.cover {
  min-height: 300rpx;
  padding: 34rpx;
  background: linear-gradient(135deg, #183f32 0%, #2d8065 100%);
  color: #ffffff;
}

.scope {
  display: inline-flex;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 700;
}

.cover-title {
  margin-top: 72rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.cover-sub {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.8);
}

.block,
.safety,
.contact {
  margin-top: 22rpx;
  padding: 26rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  color: #30352f;
  font-size: 28rpx;
}

.label {
  color: #7b877f;
}

.desc {
  margin-top: 18rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee6dc;
  color: #5c675f;
  font-size: 27rpx;
  line-height: 1.55;
}

.safety {
  background: #fff9e9;
  color: #6f5b2c;
  line-height: 1.55;
  font-size: 25rpx;
}

.safety-title,
.contact-title {
  margin-bottom: 10rpx;
  font-weight: 800;
  color: #20231f;
  font-size: 29rpx;
}

.primary-btn {
  margin-top: 26rpx;
}

.contact {
  background: #f4fbf7;
}

.contact-row {
  margin-top: 12rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: #183f32;
}

.remaining {
  margin-top: 18rpx;
  color: #7b877f;
  font-size: 24rpx;
}
