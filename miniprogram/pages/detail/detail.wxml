<view class="page detail-page">
  <view wx:if="{{loading}}" class="state-card panel">正在读取详情...</view>

  <view wx:elif="{{item}}" class="detail">
    <view class="topbar">
      <view class="icon-btn" bindtap="goBack"><text class="fa">{{icons.arrowLeft}}</text></view>
      <view class="screen-title">互助详情</view>
      <view class="icon-btn"><text class="fa">{{icons.shieldHeart}}</text></view>
    </view>

    <view class="detail-hero soft-card">
      <view class="detail-img"><text class="fa">{{item.itemIconGlyph}}</text></view>
      <view class="detail-title">{{item.title}}</view>
      <view class="badge-row">
        <text class="badge badge-main">{{item.itemTypeText}}</text>
        <text class="badge badge-main">{{item.category}}</text>
        <text class="badge">{{item.distanceLabel}}</text>
        <text class="badge">{{item.expireDate}} 到期</text>
      </view>
    </view>

    <view class="detail-card soft-card">
      <view class="detail-row">
        <view class="detail-label"><text class="fa">{{icons.locationDot}}</text> 位置</view>
        <view class="detail-val">{{item.campus}} · {{item.building}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label"><text class="fa">{{icons.box}}</text> 余量</view>
        <view class="detail-val">{{item.quantity}}{{item.unit}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label"><text class="fa">{{icons.clipboardList}}</text> 说明</view>
        <view class="detail-val">{{item.description}}</view>
      </view>
    </view>

    <view class="info-callout">
      <text class="fa">{{icons.circleInfo}}</text>
      <text>平台仅做校园免费互助信息撮合。药品类仅限非处方常见分类，请自行确认包装、有效期和适用风险；禁止处方药、管控药和收费交易。</text>
    </view>

    <view class="contact-card soft-card">
      <view wx:if="{{!contact}}" class="contact-hidden">
        <view class="contact-hint">联系方式默认隐藏，每日查看次数有限。</view>
        <button class="contact-btn" bindtap="revealContact">
          <text class="fa">{{icons.idCard}}</text>
          <text>查看联系方式</text>
        </button>
      </view>

      <view wx:else class="contact-revealed">
        <view class="contact-title">联系方式</view>
        <view wx:if="{{contact.wechat}}" class="contact-row">微信：{{contact.wechat}}</view>
        <view wx:if="{{contact.qq}}" class="contact-row">QQ：{{contact.qq}}</view>
        <view class="remaining">今日剩余查看次数：{{remaining}}</view>
      </view>
    </view>
  </view>
</view>
