.intro {
  padding: 30rpx;
  background: #e7f5ed;
}

.intro-title {
  color: #183f32;
  font-size: 38rpx;
  font-weight: 800;
}

.intro-sub {
  margin-top: 12rpx;
  color: #5c675f;
  font-size: 26rpx;
  line-height: 1.55;
}

.form {
  margin-top: 22rpx;
  padding: 26rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #52605a;
  font-size: 25rpx;
  font-weight: 700;
}

input,
textarea,
.picker {
  width: 100%;
  border-radius: 14rpx;
  background: #f9f8f5;
  border: 1rpx solid #e6ded4;
  color: #20231f;
  font-size: 28rpx;
}

input,
.picker {
  height: 78rpx;
  padding: 0 18rpx;
  line-height: 78rpx;
}

textarea {
  min-height: 160rpx;
  padding: 18rpx;
  line-height: 1.5;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.primary-btn {
  margin-top: 24rpx;
}
