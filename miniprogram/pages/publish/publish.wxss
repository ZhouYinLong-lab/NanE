.publish-page {
  overflow-x: hidden;
}

.publish-rules {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  display: flex;
  gap: 16rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e1d2bd;
  background: rgba(255, 250, 242, 0.74);
  box-shadow: 0 8rpx 22rpx rgba(96, 68, 36, 0.06);
}

.rules-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: rgba(75, 18, 63, 0.1);
  color: #4b123f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.rules-copy {
  flex: 1;
  min-width: 0;
}

.rules-title {
  margin-bottom: 4rpx;
  color: #2f261d;
  font-size: 25rpx;
  font-weight: 900;
}

.rules-text {
  color: #8a7661;
  font-size: 22rpx;
  line-height: 1.5;
}

.rules-warn {
  margin-top: 2rpx;
  color: #4b123f;
  font-weight: 800;
}

.form {
  padding: 22rpx;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  margin-bottom: 9rpx;
  color: #6f5a45;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.35;
}

.label-hint {
  margin-left: 8rpx;
  color: #8a7661;
  font-size: 20rpx;
  font-weight: 700;
}

.section-label {
  margin-bottom: 6rpx;
  color: #2f261d;
  font-size: 28rpx;
  font-weight: 900;
}

.section-help {
  margin-bottom: 18rpx;
  color: #8a7661;
  font-size: 22rpx;
  line-height: 1.5;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.location-parse {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.location-parse input {
  flex: 1;
  min-width: 0;
}

.parse-btn {
  width: 102rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  color: #fffaf2;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 72rpx;
  flex-shrink: 0;
}

.contact-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #efe4d4;
}

.disclaimer {
  display: flex;
  gap: 10rpx;
  color: #6f5a45;
  font-size: 22rpx;
  line-height: 1.6;
  align-items: flex-start;
}

.disclaimer checkbox {
  flex-shrink: 0;
  margin-top: 2rpx;
}

.submit-btn {
  margin-top: 24rpx;
  margin-bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
