.publish-page {
  overflow-x: hidden;
}

.brand-block {
  text-align: right;
  min-width: 0;
}

.form {
  margin-top: 26rpx;
}

.rules-warn {
  margin-top: 8rpx;
  font-weight: 800;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 9rpx;
  color: #222222;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.label-hint {
  margin-left: 8rpx;
  color: #666666;
  font-size: 21rpx;
  font-weight: 400;
  white-space: nowrap;
}

.field-control {
  width: 100%;
  border-radius: 15rpx;
  background: transparent;
  border: 1rpx solid #dedbd2;
  color: #222222;
  font-size: 27rpx;
}

.field-control,
.picker {
  height: 74rpx;
  padding: 0 18rpx;
  line-height: 74rpx;
}

.textarea-control {
  height: auto;
  min-height: 156rpx;
  padding: 18rpx;
  line-height: 1.5;
}

.grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}

.location-parse {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.location-parse input {
  flex: 1;
  min-width: 0;
}

.parse-btn {
  width: 104rpx;
  height: 74rpx;
  margin: 0;
  border-radius: 15rpx;
  background: #222222;
  color: #f4f2eb;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 74rpx;
  flex-shrink: 0;
}

.primary-btn {
  margin-top: 30rpx;
  margin-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.disclaimer {
  display: flex;
  gap: 10rpx;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.6;
  align-items: flex-start;
}

.disclaimer checkbox {
  flex-shrink: 0;
  margin-top: 2rpx;
}

@media (min-width: 420px) {
  .grid {
    grid-template-columns: 1fr 1fr;
    gap: 18rpx;
  }
}
