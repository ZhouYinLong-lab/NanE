<view class="page">
  <view class="brand-header">
    <view class="round-action">←</view>
    <view class="brand-block">
      <view class="brand-title">发布</view>
      <view class="brand-subtitle">Upload Items</view>
    </view>
  </view>

  <view class="disclaimer-box">
    <text class="disclaimer-title">[!] 平台发布规范</text>
    <view>退烧降温、消毒护理、外伤处理、防护用品、其他低风险应急耗材。</view>
    <view class="rules-warn">禁止处方药、管控药、拆封不明物品和任何形式的收费交易。</view>
  </view>

  <view class="form">
    <view class="field">
      <view class="label">物品名称 *</view>
      <input data-key="title" value="{{form.title}}" bindinput="updateField" placeholder="例如：碘伏棉签 10 支" />
    </view>

    <view class="field">
      <view class="label">分类 *</view>
      <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="chooseCategory">
        <view class="picker">{{categories[categoryIndex]}}</view>
      </picker>
    </view>

    <view class="grid">
      <view class="field">
        <view class="label">数量 *</view>
        <input data-key="quantity" value="{{form.quantity}}" bindinput="updateField" type="number" />
      </view>
      <view class="field">
        <view class="label">单位</view>
        <input data-key="unit" value="{{form.unit}}" bindinput="updateField" />
      </view>
    </view>

    <view class="grid">
      <view class="field">
        <view class="label">校区</view>
        <input data-key="campus" value="{{form.campus}}" bindinput="updateField" />
      </view>
      <view class="field">
        <view class="label">楼栋 *</view>
        <input data-key="building" value="{{form.building}}" bindinput="updateField" />
      </view>
    </view>

    <view class="field">
      <view class="label">有效期 *</view>
      <input data-key="expireDate" value="{{form.expireDate}}" bindinput="updateField" placeholder="YYYY-MM-DD" />
    </view>

    <view class="field">
      <view class="label">补充说明</view>
      <textarea data-key="description" value="{{form.description}}" bindinput="updateField" placeholder="包装状态、领取时间、注意事项" />
    </view>

    <checkbox-group bindchange="toggleDisclaimer">
      <label class="disclaimer">
        <checkbox value="accepted" checked="{{form.disclaimerAccepted}}" color="#671463" />
        <text>我确认本次发布为免费校园互助信息，物品不属于处方药/管控药，信息真实且愿意接受人工审核。</text>
      </label>
    </checkbox-group>
  </view>

  <button class="primary-btn" loading="{{submitting}}" bindtap="submit">提交审核</button>
</view>
