<view class="page publish-page">
  <view class="topbar">
    <view class="avatar"><text class="fa">{{icons.pen}}</text></view>
    <view class="screen-title">发布互助</view>
    <view class="icon-btn"><text class="fa">{{icons.shieldHeart}}</text></view>
  </view>

  <view class="publish-rules">
    <view class="rules-mark"><text class="fa">{{icons.circleInfo}}</text></view>
    <view class="rules-copy">
      <view class="rules-title">发布规范</view>
      <view class="rules-text">
        <text class="rules-emphasis">支持</text>
        <text>低风险应急耗材与非处方常见药品免费互助，发布后需</text>
        <text class="rules-emphasis">人工审核</text>
        <text>。</text>
      </view>
    </view>
  </view>

  <view class="form soft-card">
    <view class="field">
      <view class="label">物品类型 *</view>
      <view class="type-segment">
        <view
          wx:for="{{itemTypes}}"
          wx:key="value"
          class="type-option {{itemTypeIndex === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="chooseItemType"
        >{{item.label}}</view>
      </view>
      <view class="type-hint">{{typeHint}}</view>
    </view>

    <view class="field">
      <view class="label">物品名称 *</view>
      <input class="field-control" data-key="title" value="{{form.title}}" bindinput="updateField" placeholder="{{titlePlaceholder}}" />
    </view>

    <view wx:if="{{showCategoryPicker}}" class="field">
      <view class="label">分类 *</view>
      <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="chooseCategory">
        <view class="picker field-control">{{categories[categoryIndex]}}</view>
      </picker>
    </view>
    <view wx:else class="field">
      <view class="label">分类</view>
      <view class="type-hint">耗材无需再选择细分类，默认按“应急耗材”提交审核。</view>
    </view>

    <view class="field">
      <view class="label">选择图标 <text class="label-hint">可选，默认 {{selectedIconLabel}}</text></view>
      <scroll-view scroll-x class="icon-scroll">
        <view
          wx:for="{{iconOptions}}"
          wx:key="key"
          class="icon-choice {{form.itemIcon === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="chooseIcon"
        >
          <text class="fa icon-choice-glyph">{{item.glyph}}</text>
          <text class="icon-choice-label">{{item.label}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="grid">
      <view class="field">
        <view class="label">数量 *</view>
        <input class="field-control" data-key="quantity" value="{{form.quantity}}" bindinput="updateField" type="number" />
      </view>
      <view class="field">
        <view class="label">单位</view>
        <input class="field-control" data-key="unit" value="{{form.unit}}" bindinput="updateField" />
      </view>
    </view>

    <view class="field">
      <view class="label">快速识别位置 <text class="label-hint">如：鼓楼 南二 321</text></view>
      <view class="location-parse">
        <input class="field-control" value="{{locationText}}" bindinput="updateLocationText" placeholder="输入校区 楼栋 宿舍号" />
        <button class="parse-btn" bindtap="parseLocation">识别</button>
      </view>
    </view>

    <view class="field">
      <view class="label">校区 / 楼栋 / 宿舍号 <text class="label-hint">宿舍号选填</text></view>
      <picker
        mode="multiSelector"
        range="{{locationColumns}}"
        value="{{locationSelection}}"
        bindchange="onLocationChange"
        bindcolumnchange="onLocationColumnChange"
      >
        <view class="picker field-control">{{locationLabel}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">有效期 *</view>
      <input class="field-control" data-key="expireDate" value="{{form.expireDate}}" bindinput="updateField" placeholder="YYYY-MM-DD" />
    </view>

    <view class="field">
      <view class="label">补充说明</view>
      <textarea class="field-control textarea-control" data-key="description" value="{{form.description}}" bindinput="updateField" placeholder="包装状态、领取时间、注意事项" />
    </view>

    <view class="contact-section">
      <view class="section-label">联系方式</view>
      <view class="section-help">审核通过后，领取者点击详情页按钮才会看到联系方式。</view>
      <view class="field">
        <view class="label">微信号 <text class="label-hint">微信 / QQ 至少填一项</text></view>
        <input class="field-control" data-key="contactWechat" value="{{form.contactWechat}}" bindinput="updateField" placeholder="请输入可联系的微信号" />
      </view>
      <view class="field">
        <view class="label">QQ 号</view>
        <input class="field-control" data-key="contactQq" value="{{form.contactQq}}" bindinput="updateField" placeholder="请输入可联系的 QQ 号" />
      </view>
    </view>

    <checkbox-group bindchange="toggleDisclaimer">
      <label class="disclaimer">
        <checkbox value="accepted" checked="{{form.disclaimerAccepted}}" color="#6E0065" />
        <text>我确认本次发布为免费校园互助信息；药品类仅限非处方常见分类，物品不属于处方药/管控药，信息真实且愿意接受人工审核。</text>
      </label>
    </checkbox-group>
  </view>

  <button class="primary-btn submit-btn" loading="{{submitting}}" bindtap="submit">
    <text class="fa">{{icons.check}}</text>
    <text>提交审核</text>
  </button>
</view>
