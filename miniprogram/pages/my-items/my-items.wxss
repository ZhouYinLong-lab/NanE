.my-item-card {
  margin-top: 18rpx;
  padding: 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border: 1rpx solid #e2dfd6;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.28);
}

.item-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.34);
  font-size: 36rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.icon-yellow {
  background: #dbcada;
}

.icon-red {
  background: #f3edf3;
}

.icon-grey {
  background: #c4c5bd;
}

.main {
  flex: 1;
  min-width: 0;
}

.name {
  color: #222222;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.28;
  word-break: break-word;
}

.meta,
.time,
.reason {
  margin-top: 8rpx;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-word;
}

.reason {
  color: #9f3d33;
}

.status {
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.2;
}

.online {
  border: 1rpx solid #671463;
  color: #671463;
}

.reviewing {
  border: 1rpx solid #d5d3cc;
  color: #222222;
}

.rejected,
.expired,
.taken_down {
  border: 1rpx solid #671463;
  color: #671463;
}
