.empty {
  padding: 40rpx;
  text-align: center;
  color: #666666;
}

.list-item {
  padding: 34rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  border-bottom: 1rpx solid #e0ddd3;
}

.item-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.34);
  font-size: 40rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.icon-yellow {
  background: #dbcada;
}

.icon-red {
  background: #f3edf3;
}

.icon-grey {
  background: #c4c5bd;
}

.main {
  flex: 1;
  min-width: 0;
}

.name {
  color: #222222;
  font-size: 31rpx;
  font-weight: 900;
}

.meta,
.time,
.reason {
  margin-top: 8rpx;
  color: #666666;
  font-size: 24rpx;
}

.reason {
  color: #9f3d33;
}

.status {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.online {
  border: 1rpx solid #671463;
  color: #671463;
}

.reviewing {
  border: 1rpx solid #d5d3cc;
  color: #222222;
}

.rejected,
.expired,
.taken_down {
  border: 1rpx solid #671463;
  color: #671463;
}
