.my-items-page {
  overflow-x: hidden;
}

.chips {
  width: 100%;
  margin-bottom: 16rpx;
  white-space: nowrap;
  overflow: hidden;
}

.chip {
  display: inline-flex;
  margin-right: 10rpx;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e4ded3;
  background: #fffaf2;
  color: #6f6a61;
  font-size: 22rpx;
  font-weight: 800;
}

.chip.active {
  border-color: transparent;
  background: #1f1f1f;
  color: #fffaf2;
}

.tips-card {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e4ded3;
  background: #fffaf2;
  color: #6f6a61;
  display: flex;
  gap: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.tips-card .fa {
  margin-top: 4rpx;
  color: #6E0065;
}

.my-item {
  margin-bottom: 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e4ded3;
  background: #fffaf2;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  box-shadow: 0 8rpx 22rpx rgba(96, 68, 36, 0.06);
}

.my-item-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  color: #6E0065;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.tone-purple {
  background: rgba(110, 0, 101, 0.09);
}

.tone-brown {
  background: #efe7da;
}

.tone-cream {
  background: #f3eadf;
}

.my-item-info {
  flex: 1;
  min-width: 0;
}

.my-item-name {
  color: #1f1f1f;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-word;
}

.my-item-meta,
.reason {
  margin-top: 6rpx;
  color: #6f6a61;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-word;
}

.reason {
  color: #9b3d32;
  font-weight: 800;
}

.status-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.online {
  background: #e0f5e3;
  color: #287a30;
}

.reviewing {
  background: #fff3cd;
  color: #8a6d14;
}

.rejected,
.expired,
.taken_down {
  background: #f8dfd8;
  color: #9b3d32;
}
