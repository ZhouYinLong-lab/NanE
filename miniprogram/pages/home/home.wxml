<view class="page home-page">
  <view class="brand-head">
    <view class="brand-copy">
      <view class="brand-title-row">
        <text class="brand-title">南易</text>
        <image class="brand-logo" src="/assets/brand/nane-logo.png" mode="aspectFit" />
      </view>
      <view class="brand-subtitle">CAMPUS MUTUAL AID</view>
    </view>
    <view class="icon-btn search-round" bindtap="toggleSearch">
      <text class="fa">{{iconMagnifyingGlass}}</text>
    </view>
  </view>

  <view wx:if="{{showSearch}}" class="search-row">
    <view class="search-box">
      <text class="fa search-icon">{{iconMagnifyingGlass}}</text>
      <input value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" placeholder="搜索退烧贴、碘伏、创可贴" />
    </view>
    <button class="filter-btn" bindtap="onSearch">
      <text class="fa">{{iconFilter}}</text>
    </button>
  </view>

  <scroll-view scroll-x class="chips">
    <view
      wx:for="{{filterChips}}"
      wx:key="key"
      class="chip {{activeChip === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="chooseFilter"
    >{{item.label}}</view>
  </scroll-view>

  <view class="section-head">
    <view>
      <view class="section-title">附近物品</view>
      <view class="section-more">{{viewer.building || '南苑 A 栋'}} · 优先排序</view>
    </view>
    <view class="section-more">查看全部</view>
  </view>

  <view wx:if="{{loading}}" class="state-card panel">正在连接 NanE API...</view>
  <view wx:elif="{{errorMessage}}" class="state-card panel">
    <view>{{errorMessage}}</view>
    <button class="retry" bindtap="loadItems">重试</button>
  </view>
  <view wx:elif="{{items.length === 0}}" class="state-card panel">暂时没有符合条件的物品</view>

  <view class="rules-line">
    <text class="fa">{{iconCircleInfo}}</text>
    <text>禁止处方药、管控药和任何形式收费转让。</text>
  </view>

  <view class="item-list" wx:if="{{!loading && !errorMessage && items.length > 0}}">
    <view wx:for="{{items}}" wx:key="id" class="aid-item" data-id="{{item.id}}" bindtap="openDetail">
      <view class="aid-icon {{index % 2 === 0 ? 'tone-purple' : 'tone-cream'}}">
        <text class="fa">{{item.itemIconGlyph}}</text>
      </view>
      <view class="aid-info">
        <view class="aid-row">
          <view class="aid-title">{{item.title}}</view>
          <view class="aid-loc">{{item.campus}} {{item.building}}</view>
        </view>
        <view wx:if="{{item.description}}" class="aid-desc">{{item.description}}</view>
        <view wx:else class="aid-desc">发布者暂未填写补充说明。</view>
        <view class="aid-tags">
          <text class="aid-tag accent">{{item.itemTypeText}}</text>
          <text class="aid-tag">{{item.category}}</text>
          <text class="aid-tag">数量：{{item.quantity}}{{item.unit}}</text>
          <text class="aid-tag">人工审核通过</text>
          <text class="aid-tag">{{item.expireDate}} 到期</text>
        </view>
      </view>
    </view>
  </view>
</view>
