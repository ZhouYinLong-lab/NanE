.home-page {
  overflow-x: hidden;
}

.search-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e1d2bd;
  background: #fffaf2;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 22rpx rgba(96, 68, 36, 0.06);
}

.search-icon {
  color: #a8794a;
  font-size: 24rpx;
}

.search-box input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #2f261d;
  font-size: 25rpx;
}

.filter-btn {
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  color: #fffaf2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  line-height: 72rpx;
  box-shadow: 0 10rpx 22rpx rgba(75, 18, 63, 0.22);
}

.chips {
  width: 100%;
  margin-bottom: 18rpx;
  white-space: nowrap;
  overflow: hidden;
}

.chip {
  display: inline-flex;
  margin-right: 10rpx;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e1d2bd;
  background: #fffaf2;
  color: #6f5a45;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.chip.active {
  border-color: transparent;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  color: #fffaf2;
  box-shadow: 0 8rpx 18rpx rgba(75, 18, 63, 0.18);
}

.hero-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #fffaf2;
  box-shadow: 0 14rpx 32rpx rgba(75, 18, 63, 0.18);
}

.hero-title {
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.hero-desc {
  color: rgba(255, 250, 242, 0.78);
  font-size: 21rpx;
  line-height: 1.45;
}

.hero-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.rules-strip {
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e1d2bd;
  background: rgba(255, 250, 242, 0.7);
  color: #6f5a45;
  display: flex;
  gap: 12rpx;
  align-items: center;
  font-size: 22rpx;
  line-height: 1.45;
}

.rules-strip .fa {
  color: #4b123f;
}

.retry {
  width: 136rpx;
  height: 58rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #8b5e34, #4b123f);
  color: #fffaf2;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.item-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.item-card {
  min-width: 0;
  overflow: hidden;
  border-radius: 26rpx;
  border: 1rpx solid #e1d2bd;
  background: #fffaf2;
  box-shadow: 0 10rpx 26rpx rgba(96, 68, 36, 0.07);
}

.item-img {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4b123f;
  font-size: 42rpx;
}

.tone-purple {
  background: rgba(75, 18, 63, 0.09);
}

.tone-brown {
  background: rgba(139, 94, 52, 0.14);
}

.tone-cream {
  background: #f3eadf;
}

.item-info {
  padding: 14rpx 16rpx 16rpx;
}

.item-name {
  margin-bottom: 6rpx;
  color: #2f261d;
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-loc {
  margin-bottom: 8rpx;
  color: #8a7661;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-loc .fa {
  color: #4b123f;
  font-size: 18rpx;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.item-tag,
.priority-badge {
  max-width: 100%;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

.item-tag {
  background: #f3eadf;
  color: #4b123f;
}

.priority-badge {
  background: #fff0c8;
  color: #7a5a16;
}
