.search-row {
  margin-bottom: 24rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-row input {
  flex: 1;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d5d3cc;
  border-radius: 14rpx;
  background: transparent;
  color: #222222;
  font-size: 28rpx;
}

.search-row button {
  width: 128rpx;
  height: 78rpx;
  margin: 0;
  border-radius: 14rpx;
  background: #222222;
  color: #f4f2eb;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 78rpx;
}

.filter-tags {
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.f-tag {
  display: inline-flex;
  margin-right: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d5d3cc;
  color: #666666;
  font-size: 23rpx;
  white-space: nowrap;
}

.f-tag.active {
  background: #222222;
  color: #f4f2eb;
  border-color: #222222;
  font-weight: 800;
}

.hint {
  margin-bottom: 18rpx;
  color: #666666;
  font-size: 23rpx;
}

.empty {
  padding: 40rpx;
  color: #666666;
  text-align: center;
  font-size: 27rpx;
}

.retry {
  width: 160rpx;
  height: 64rpx;
  margin-top: 22rpx;
  border-radius: 12rpx;
  background: #222222;
  color: #f4f2eb;
  font-size: 25rpx;
  line-height: 64rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #e0ddd3;
}

.item-icon {
  width: 112rpx;
  height: 112rpx;
  margin-right: 26rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: rgba(0, 0, 0, 0.34);
  font-size: 46rpx;
  font-weight: 900;
}

.icon-yellow {
  background: #dbcada;
}

.icon-red {
  background: #f3edf3;
}

.icon-grey {
  background: #c4c5bd;
}

.item-content {
  flex: 1;
  min-width: 0;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.item-name {
  color: #222222;
  font-size: 32rpx;
  font-weight: 900;
}

.meta-info {
  color: #666666;
  font-size: 21rpx;
  white-space: nowrap;
}

.description {
  margin-bottom: 14rpx;
  color: #666666;
  font-size: 25rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}
