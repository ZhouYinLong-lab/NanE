.home-page {
  overflow-x: hidden;
}

.search-row {
  margin-bottom: 20rpx;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.search-row input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dedbd2;
  border-radius: 13rpx;
  background: transparent;
  color: #222222;
  font-size: 26rpx;
}

.search-row button {
  width: 106rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 13rpx;
  background: #222222;
  color: #f4f2eb;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
  flex-shrink: 0;
}

.filter-tags {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
  overflow: hidden;
}

.f-tag {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 11rpx 21rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dedbd2;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.f-tag.active {
  background: #222222;
  color: #f4f2eb;
  border-color: #222222;
  font-weight: 800;
}

.hint {
  margin-bottom: 18rpx;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.4;
}

.retry {
  width: 138rpx;
  height: 60rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #222222;
  color: #f4f2eb;
  font-size: 24rpx;
  line-height: 60rpx;
}

.item-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e2dfd6;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.28);
}

.item-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: rgba(0, 0, 0, 0.34);
  font-size: 40rpx;
  font-weight: 900;
}

.icon-yellow {
  background: #dbcada;
}

.icon-red {
  background: #f3edf3;
}

.icon-grey {
  background: #c4c5bd;
}

.item-content {
  flex: 1;
  min-width: 0;
}

.item-header {
  margin-bottom: 8rpx;
}

.item-name {
  color: #222222;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.meta-info {
  margin-top: 6rpx;
  color: #666666;
  font-size: 22rpx;
  line-height: 1.35;
}

.description {
  margin-bottom: 12rpx;
  color: #666666;
  font-size: 24rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: -8rpx;
}
