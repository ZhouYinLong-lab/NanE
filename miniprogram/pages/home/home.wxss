.home-page {
  overflow-x: hidden;
  padding-top: 46rpx;
}

.brand-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 44rpx;
}

.brand-copy {
  min-width: 0;
  flex: 1;
}

.brand-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-title {
  color: #1f1f1f;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 1rpx;
}

.brand-logo {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
}

.brand-subtitle {
  margin-top: 16rpx;
  color: #6f6a61;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 7rpx;
  line-height: 1.2;
}

.search-round {
  width: 80rpx;
  height: 80rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: transparent;
  border-color: #ded8cc;
  color: #6f6a61;
  font-size: 30rpx;
  box-shadow: none;
}

.search-row {
  display: flex;
  gap: 12rpx;
  margin: -22rpx 0 24rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ded8cc;
  background: #fffaf2;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-icon {
  color: #6E0065;
  font-size: 23rpx;
}

.search-box input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #1f1f1f;
  font-size: 24rpx;
}

.filter-btn {
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 50%;
  background: #6E0065;
  color: #fffaf2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 72rpx;
}

.chips {
  width: 100%;
  margin-bottom: 64rpx;
  white-space: nowrap;
  overflow: hidden;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  margin-right: 18rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ded8cc;
  background: transparent;
  color: #6f6a61;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.chip.active {
  border-color: #1f1f1f;
  background: #1f1f1f;
  color: #fffaf2;
}

.section-head {
  margin: 0 0 18rpx;
}

.section-title {
  font-size: 44rpx;
  letter-spacing: -1rpx;
}

.section-more {
  margin-top: 8rpx;
}

.rules-line {
  margin-bottom: 18rpx;
  padding: 0 0 18rpx;
  border-bottom: 1rpx solid #e4ded3;
  color: #6f6a61;
  display: flex;
  gap: 12rpx;
  align-items: center;
  font-size: 22rpx;
  line-height: 1.45;
}

.rules-line .fa {
  color: #6E0065;
}

.retry {
  width: 136rpx;
  height: 58rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #6E0065;
  color: #fffaf2;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.item-list {
  padding-bottom: 20rpx;
}

.aid-item {
  display: flex;
  align-items: flex-start;
  gap: 26rpx;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #e4ded3;
}

.aid-icon {
  width: 118rpx;
  height: 118rpx;
  border-radius: 22rpx;
  color: #6E0065;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.tone-purple {
  background: #f0e6ef;
}

.tone-cream {
  background: #efe7da;
}

.aid-info {
  flex: 1;
  min-width: 0;
}

.aid-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 10rpx;
}

.aid-title {
  flex: 1;
  min-width: 0;
  color: #1f1f1f;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.aid-loc {
  max-width: 190rpx;
  color: #6f6a61;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 0;
}

.aid-desc {
  color: #6f6a61;
  font-size: 25rpx;
  line-height: 1.55;
  font-weight: 600;
  word-break: break-word;
}

.aid-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.aid-tag {
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ded8cc;
  background: #fffaf2;
  color: #1f1f1f;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
}

.aid-tag.accent {
  border-color: #6E0065;
  color: #6E0065;
}
